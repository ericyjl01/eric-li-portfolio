---
import Base from '../../layouts/Base.astro';
import { profile, socials, caseStudies } from '../../data/content';
import type { CaseStudy } from '../../data/content';

// One static page per case study in the record.
export function getStaticPaths() {
  return Object.values(caseStudies).map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;

const laneLabel = study.lane === 'ai' ? 'AI / LLM Engineering' : 'Data Analytics & BI';
const pageTitle = `${study.title} — ${profile.name}`;
const metaBits = [
  { k: 'Where', v: `${study.meta.org} · ${study.meta.role}` },
  { k: 'When', v: study.meta.timeframe },
  { k: 'Stack', v: study.meta.stack },
];
---

<Base title={pageTitle} description={study.dek}>
  <!-- ===================== NAV ===================== -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/">{profile.name}</a>
      <nav class="nav-right">
        <div class="nav-links">
          <a class="link" href="/#work">Work</a>
          <a class="link" href="/#about">About</a>
          {socials.resume && <a class="link" href={socials.resume}>Résumé</a>}
        </div>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="wrap case">
    <!-- back to index -->
    <a class="case-back" href="/#work"><span class="arw">←</span> Selected Work</a>

    <!-- ===================== HEADER ===================== -->
    <header class="case-hero">
      <div class="lane"><span class={`pip ${study.lane}`}></span>{laneLabel}</div>
      <h1>{study.title}</h1>
      <p class="case-dek">{study.dek}</p>

      <div class="case-metric">
        {study.metric.from ? (
          <span class="delta">{study.metric.label}&nbsp;<b>{study.metric.from}</b> <span class="a">→</span> <b>{study.metric.to}</b></span>
        ) : (
          <span class="delta">{study.metric.label}&nbsp;<b>{study.metric.to}</b></span>
        )}
        <span class="tags">{study.tags.map((t) => <span class="tag">{t}</span>)}</span>
      </div>

      <dl class="case-meta">
        {metaBits.map((m) => (
          <div>
            <dt>{m.k}</dt>
            <dd>{m.v}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- ===================== SUMMARY (problem → approach → result) ===================== -->
    <section class="case-summary">
      {study.summary.map((para) => <p>{para}</p>)}
    </section>

    <!-- ===================== BODY SECTIONS ===================== -->
    {study.sections.map((sec) => (
      <section class="case-sec">
        <div class="sec-head">
          <span class="t">{sec.heading}</span>
          <span class="c">{sec.n}</span>
        </div>
        {sec.blocks.map((b) => {
          if (b.kind === 'p') return <p>{b.text}</p>;
          if (b.kind === 'list')
            return <ul class="case-list">{b.items.map((it) => <li>{it}</li>)}</ul>;
          // table
          return (
            <figure class="case-table-wrap">
              <div class="case-table-scroll">
                <table class="case-table">
                  <thead>
                    <tr>{b.columns.map((c) => <th>{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {b.rows.map((r) => (
                      <tr>{r.map((cell, ci) => (ci === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {b.caption && <figcaption>{b.caption}</figcaption>}
            </figure>
          );
        })}
      </section>
    ))}

    <!-- ===================== CLOSE ===================== -->
    <section class="case-close">
      <a class="case-back" href="/#work"><span class="arw">←</span> Back to Selected Work</a>
      <a class="repo-link" href={`mailto:${socials.email}`}>Want the detail behind this? Let’s talk ↗</a>
    </section>
  </main>

  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  </script>
</Base>
