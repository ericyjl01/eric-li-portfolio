---
import Base from '../layouts/Base.astro';
import {
  profile, socials, projects, repos, dashboards, writeups, about, skills,
} from '../data/content';

// GitHub mark — reused in a few places
const gh = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>`;

const rails = [
  { label: 'Repositories', items: repos, all: { label: 'All repos on GitHub', href: socials.github } },
  { label: 'Dashboards', items: dashboards, all: { label: 'View on Tableau Public', href: '#' } },
  { label: 'Writeups', items: writeups, all: { label: 'Read the blog', href: '#' } },
];

// Case-study links only render once their /work/<slug> page actually exists —
// prevents shipping 404s. Add the href here when you build each page (P1+).
const PUBLISHED_CASE_STUDIES = new Set<string>(['/work/text-to-sql']);
---

<Base>
  <!-- ===================== NAV ===================== -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/">{profile.name}</a>
      <nav class="nav-right">
        <div class="nav-links">
          <a class="link" href="#work">Work</a>
          <a class="link" href="#about">About</a>
          {socials.resume && <a class="link" href={socials.resume}>Résumé</a>}
        </div>
        <a class="btn btn-primary" href={socials.github} target="_blank" rel="noopener">
          <Fragment set:html={gh} /> GitHub
        </a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main>
    <!-- ===================== HERO ===================== -->
    <div class="wrap hero">
      <p class="eyebrow">{profile.role} · {profile.location}</p>
      <h1>{profile.headline}</h1>
      <p class="lede">{profile.lede}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#work">View Work <span class="arw">→</span></a>
        <a class="btn btn-outline" href={socials.github} target="_blank" rel="noopener">
          <Fragment set:html={gh} /> View GitHub <span class="arw">↗</span>
        </a>
        {socials.resume && <a class="btn btn-ghost" href={socials.resume}>Résumé</a>}
      </div>
      <p class="status">{profile.status}</p>
    </div>

    <!-- ===================== SELECTED WORK ===================== -->
    <section id="work" class="wrap">
      <div class="sec-head">
        <span class="t">Selected Work</span>
        <span class="c">{String(projects.length).padStart(2, '0')} projects</span>
      </div>
      {projects.map((p, i) => {
        const caseLink = p.links.find((l) => l.kind === 'case');
        const side = p.links.find((l) => l.kind !== 'case');
        return (
          <article class="row">
            <div class="idx">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="lane"><span class={`pip ${p.lane}`}></span>{p.lane === 'ai' ? 'AI / LLM Engineering' : 'Data Analytics & BI'}</div>
              <a class="title-link" href={caseLink?.href ?? '#'}><h3>{p.title}</h3></a>
              <p>{p.blurb}</p>
              <div class="meta">
                {p.from ? (
                  <span class="delta">{p.metricLabel}&nbsp;<b>{p.from}</b> <span class="a">→</span> <b>{p.to}</b></span>
                ) : (
                  <span class="delta">{p.metricLabel}&nbsp;<b>{p.to}</b></span>
                )}
                <span class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</span>
              </div>
            </div>
            <div class="right">
              {caseLink && PUBLISHED_CASE_STUDIES.has(caseLink.href) && <a class="go" href={caseLink.href}>Case study <span class="arw">→</span></a>}
              {side && (
                <a class="repo-link" href={side.href} target={side.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  {side.kind === 'repo' && <Fragment set:html={gh} />}
                  {side.label}{side.kind !== 'repo' ? ' ↗' : ''}
                </a>
              )}
            </div>
          </article>
        );
      })}
    </section>

    <!-- ===================== RAILS: Repos / Dashboards / Writeups ===================== -->
    <section class="wrap">
      {rails.map((rail) => (
        <div class="rail">
          <div class="sec-head">
            <span class="t">{rail.label}</span>
            <a class="c" href={rail.all.href} style="color:var(--ink);font-weight:600">{rail.all.label} →</a>
          </div>
          <ul>
            {rail.items.map((it) => (
              <li>
                <a class="rail-item" href={it.href} target={it.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span>{it.label}</span><span class="arw">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- ===================== ABOUT ===================== -->
    <section id="about" class="wrap about">
      <div class="sec-head"><span class="t">About</span></div>
      {about.map((para) => <p>{para}</p>)}
    </section>

    <!-- ===================== SKILLS ===================== -->
    <section class="wrap">
      <div class="sec-head"><span class="t">Skills</span><span class="c">used in the work above</span></div>
      <div class="skills-grid">
        {skills.map((s) => (
          <div class="skill-group">
            <div class="g-label">{s.group}</div>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- ===================== FOOTER / CONTACT ===================== -->
  <footer id="contact" class="footer">
    <div class="wrap">
      <h2>Let’s build something measurable.</h2>
      <div class="contacts">
        <a href={`mailto:${socials.email}`}>Email</a>
        <a href={socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={socials.github} target="_blank" rel="noopener"><Fragment set:html={gh} /> GitHub</a>
        {socials.resume && <a href={socials.resume}>Résumé (PDF)</a>}
      </div>
      <div class="fine">
        <span>© 2026 {profile.name}</span>
        <span>Built with Astro · {profile.location}</span>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  </script>
</Base>
